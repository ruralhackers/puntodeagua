DATABASE_URL=postgresql://puntodeagua2_user:puntodeagua2_password@localhost:5559/puntodeagua2_test
NODE_ENV=test
NEXTAUTH_SECRET=test-secret-not-used
SKIP_ENV_VALIDATION=1

# apps/webapp/src/server/auth/index.ts builds the Nodemailer EmailProvider at
# module load time, so importing the tRPC router needs these to be present.
# No mail is ever sent: the tests never exercise the email sign-in flow.
EMAIL_SERVER=smtp://user:pass@localhost:1025
EMAIL_FROM=test@example.com
